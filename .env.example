# --------------------------------------------------------------------
# Customigniter 3 - environment configuration
# --------------------------------------------------------------------
# Copy this file to .env and adjust the values for your machine.
# Real environment variables always override values defined here.
# Never commit the .env file itself (it is git-ignored).

# Application environment: development, testing or production
CI_ENVIRONMENT=development

# Base URL of the application (used by config.php)
#BASE_URL=http://localhost:8080/

# Database connection (used by database.php)
#DB_DRIVER=mysqli
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=

# Encryption key for the Encryption library (config.php)
#ENCRYPTION_KEY=
