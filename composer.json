{
	"description": "Customigniter 3 - A modernized fork of CodeIgniter 3 for PHP 8.4+",
	"name": "customigniter/framework",
	"type": "project",
	"homepage": "https://github.com/imamrasyid/customigniter-3",
	"license": "MIT",
	"bin": [
		"customigniter"
	],
	"support": {
		"source": "https://github.com/imamrasyid/customigniter-3"
	},
	"require": {
		"php": ">=8.4",
		"psr/log": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"Customigniter\\": "src/"
		}
	},
	"scripts": {
		"test": "phpunit --configuration tests/phpunit.xml --no-coverage",
		"test:coverage": [
			"@putenv XDEBUG_MODE=coverage",
			"phpunit --color=always --coverage-text --configuration tests/phpunit.xml"
		]
	},
	"require-dev": {
		"mikey179/vfsstream": "^1.6.12",
		"phpunit/phpunit": "^9.6",
		"phpstan/phpstan": "^2.2"
	}
}
